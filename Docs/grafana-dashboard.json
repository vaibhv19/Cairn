      "id": 2,
      "title": "Node A - Active Keys Count",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(cairn_cache_total{instance=~\"localhost:8081.*|.*:8081\", statistic=\"COUNT_KEYS\"})",
          "legendFormat": "Node A Keys",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
